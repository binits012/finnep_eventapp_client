# Copy to ios/.xcode.env (gitignored).
#
# Optional: override Stripe publishable keys for Xcode builds without editing
# bundled .env files. Per-flavor keys are preferred:
#
#   STRIPE_PUBLISHABLE_KEY_EU=pk_live_...
#   STRIPE_PUBLISHABLE_KEY_AU=pk_live_...
#
# Optional iOS bundle overrides (Android ids stay in android/app/build.gradle.kts):
#   EU_APPLICATION_ID=com.finnep.okazzo.eu
#   AU_APPLICATION_ID=com.finnep.okazzo.au
#
# Optional fallback (used for both flavors if per-flavor keys are empty):
#   STRIPE_PUBLISHABLE_KEY=pk_live_...
#
# If a value contains special characters (for example `#`), wrap it in quotes.
#
# Then run: ios/scripts/generate_flavor_configs.sh
STRIPE_PUBLISHABLE_KEY_EU=
STRIPE_PUBLISHABLE_KEY_AU=
STRIPE_PUBLISHABLE_KEY=
